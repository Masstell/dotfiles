{
  "services": [
    {
      "name": "web",
      "image": "nginx:1.27.3",
      "port": 8080,
      "depends_on": [
        "api"
      ]
    },
    {
      "name": "api",
      "image": "example/api:3.1.0",
      "port": 8081,
      "depends_on": [
        "db"
      ]
    },
    {
      "name": "worker",
      "image": "example/worker:2.4.1",
      "port": 8082,
      "depends_on": [
        "api",
        "db"
      ]
    },
    {
      "name": "db",
      "image": "postgres:17.2",
      "port": 5432
    }
  ]
}
